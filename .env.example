# Copy to .env and set ONE provider. Leave all keys empty for the offline rules mode.

# OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...). LLM_API_KEY is an alias of OPENAI_API_KEY.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Extra JSON merged into requests, e.g. {"chat_template_kwargs": {"enable_thinking": false}} for Qwen3 on vLLM.
LLM_EXTRA_BODY=

# Anthropic (default model claude-opus-5-5). Optional: LLM_EFFORT=low|medium|high
ANTHROPIC_API_KEY=
LLM_EFFORT=

# Optional OpenAI-compatible fallback used when the primary fails or its circuit breaker is open.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

LLM_TURN_BUDGET_SECONDS=45
# template: deterministic replies. llm: model-phrased replies checked by the grounding verifier.
RESPONSE_MODE=template

# Storage: SQLite path (default in the image) or a postgresql:// URL.
SESSION_DB=
DATABASE_URL=

# Enables /v1/outbox and /v1/sessions/{id}/audit with "Authorization: Bearer <token>".
ADMIN_API_TOKEN=
RATE_LIMIT_PER_MINUTE=60
